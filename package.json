{
  "name": "mtsk",
  "version": "0.2.0",
  "description": "(Demo) MetaSkill: your AI coding agent doesn't say \"done\" until it proves it. Before (contract) · During (verifiable steps) · After (independent review + evidence report) for Claude Code, Codex, and Antigravity.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jas24er/MetaSkill.git"
  },
  "homepage": "https://github.com/Jas24er/MetaSkill#readme",
  "bugs": {
    "url": "https://github.com/Jas24er/MetaSkill/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "mtsk": "./dist/index.js",
    "metaskill": "./dist/index.js"
  },
  "exports": {
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "AGENTS.md",
    "core",
    "playbooks",
    "radar",
    "templates",
    "recipes",
    "action.yml",
    "scripts/github-action-verify.mjs",
    ".claude-plugin",
    "plugins",
    "README.md",
    "README.es.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx cli/src/index.ts",
    "validate:registry": "vitest run cli/tests/schemas.test.ts"
  },
  "keywords": [
    "ai-agents",
    "agent-skills",
    "vibecoding",
    "mcp",
    "claude-code",
    "cursor",
    "antigravity",
    "codex",
    "windsurf",
    "project-architect",
    "metaskill",
    "evidence-report",
    "verification",
    "evals",
    "github-action"
  ],
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
